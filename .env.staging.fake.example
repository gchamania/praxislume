# PraxisLume fake-provider staging profile.
# Copy values into the hosting provider's secret/env store; do not deploy this
# file itself as a source of truth.

# Flutter web build-time values. These are client-visible.
SUPABASE_URL=https://your-staging-project.supabase.co
SUPABASE_ANON_KEY=your-staging-supabase-anon-key
API_BASE_URL=https://your-staging-api.example.com

# Fastify API runtime values. Keep service-role server-only.
NODE_ENV=production
HOST=0.0.0.0
PORT=8787
SUPABASE_SERVICE_ROLE_KEY=your-staging-service-role-key-server-only

# Text generation remains deterministic for first staging deploy.
AI_PROVIDER=fake
CAMPAIGN_PLAN_PROVIDER=fake
CAPTION_PROVIDER=fake
REEL_SCRIPT_PROVIDER=fake
TONE_REWRITE_PROVIDER=fake
DEFAULT_DRAFT_MODEL=fake-draft-v1
PREMIUM_REVIEW_MODEL=fake-review-v1
GENERATION_DAILY_LIMIT=20
GENERATION_TIMEOUT_MS=30000

# Visual asset smoke uses the fake image provider only.
IMAGE_GENERATION_ENABLED=true
IMAGE_PROVIDER=fake
IMAGE_GENERATION_DAILY_LIMIT=5

# Leave live image providers disabled for Sprint 2 staging.
FAL_KEY=
OPENAI_IMAGE_API_KEY=
