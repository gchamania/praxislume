# Public browser-safe values only. Do not put service-role or provider keys here.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=<supabase-anon-key>
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8787

# Default true while testing the conveyor locally before live AI wiring.
NEXT_PUBLIC_PRE_AI_CONVEYOR=true

# Keep false for the first live text-generation trial.
# Set true only when services/api has IMAGE_GENERATION_ENABLED=true.
NEXT_PUBLIC_ENABLE_VISUAL_PILOT=false
